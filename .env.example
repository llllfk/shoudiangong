# 智能体 OpenAPI（仅服务端，勿提交真实值；复制为 .env.local 后填写）
# 注意：平台禁止自定义变量以 COZE_ 开头，请使用下列名称
BOT_ID=
BOT_PAT=
BOT_USER_ID=competition_user_01

# PostgreSQL（平台系统变量，通常自动注入，本地可按需填写）
DATABASE_URL=

# 对象存储：勿手动配置。平台自动注入系统变量
# COZE_BUCKET_ENDPOINT_URL / COZE_BUCKET_NAME（及 workload identity）
# 代码内已按上述名称占位读取

# Electron / Capacitor 加载的线上地址
ELECTRON_APP_URL=https://556fwr627w.coze.site
CAPACITOR_SERVER_URL=https://556fwr627w.coze.site
