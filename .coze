[project]
entrypoint = "package.json"
requires = [ "node-22" ]
project_type = "web"
template = "nextjs"
version = "0.2.1"
appliedPatches = [ ]

[dev]
build = [
  "sh",
  "-c",
  "npm install && npm run build"
]
run = [
  "sh",
  "-c",
  "chmod +x ./scripts/serve.sh 2>/dev/null; exec ./scripts/serve.sh"
]
run_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/serve.ps1"
]

[deploy]
build = [
  "sh",
  "-c",
  "npm install && npm run build"
]
run = [
  "sh",
  "-c",
  "chmod +x ./scripts/serve.sh 2>/dev/null; exec ./scripts/serve.sh"
]
run_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/serve.ps1"
]
