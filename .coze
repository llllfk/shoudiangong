[project]
entrypoint = "package.json"
requires = [ "node-22" ]
project_type = "web"
template = "nextjs"
version = "0.2.0"
appliedPatches = [ ]

[dev]
build = [
  "npm",
  "run",
  "build"
]
run = [
  "sh",
  "-c",
  "exec npm run start -- -H 0.0.0.0 -p ${DEPLOY_RUN_PORT:-3000}"
]
run_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/serve.ps1"
]

[deploy]
build = [
  "npm",
  "run",
  "build"
]
run = [
  "sh",
  "-c",
  "exec npm run start -- -H 0.0.0.0 -p ${DEPLOY_RUN_PORT:-3000}"
]
run_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/serve.ps1"
]
