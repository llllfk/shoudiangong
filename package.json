{
  "name": "pantograph-inspection-agent",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win --config electron-builder.yml",
    "electron:deps": "npm install --no-save --no-package-lock electron@^35.0.0 electron-builder@^26.0.0",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "npx cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.2",
    "@coze/workload-identity": "^0.1.0",
    "next": "^15.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
